{
  email {$ACME_EMAIL}
}

(abess_routes) {
  encode zstd gzip

  # VLESS WebSocket over TLS
  @abess_vless_ws path /@abess237
  reverse_proxy @abess_vless_ws xray:10000

  # VLESS gRPC over TLS (h2c)
  @abess_vless_grpc path /@abess237/vless/grpc*
  reverse_proxy @abess_vless_grpc h2c://xray:10001

  # VLESS HTTPUpgrade over TLS
  @abess_vless_httpupgrade path /@abess237/vless/httpupgrade
  reverse_proxy @abess_vless_httpupgrade xray:10002

  # VLESS XHTTP over TLS
  @abess_vless_xhttp path /@abess237/vless/xhttp*
  reverse_proxy @abess_vless_xhttp xray:10003

  # Management Web Panel & API fallback
  reverse_proxy api:3000
}

{$VPN_DOMAIN} {
  import abess_routes
}

:443 {
  import abess_routes
}
