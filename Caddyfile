{
  email {$ACME_EMAIL}
  auto_https disable_redirects
}

:80 {
  @ws {
    header Upgrade *websocket*
  }
  handle @ws {
    reverse_proxy 172.18.0.1:8080
  }
  handle {
    redir https://{$VPN_DOMAIN}{uri} permanent
  }
}

{$VPN_DOMAIN} {
  @ws {
    header Upgrade *websocket*
  }
  handle @ws {
    reverse_proxy 172.18.0.1:8080
  }
  handle {
    encode zstd gzip
    reverse_proxy api:3000
  }
}
