# Copy this file to .env on the VPS. Never commit real values.
VPN_DOMAIN=vpn.example.com

# Optional exact browser origins allowed to call the API (comma-separated).
# Same-origin https://VPN_DOMAIN and localhost:5173 are allowed by default.
CORS_ALLOWED_ORIGINS=
ACME_EMAIL=admin@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=ABESS VPN Administrator
ADMIN_INITIAL_PASSWORD=replace-with-at-least-16-random-characters
MASTER_SECRET=replace-with-at-least-32-random-characters

# Telegram Management Bot (Gestion commerciale à distance via Telegram)
# Obtenez un token auprès de @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
# Liste obligatoire des identifiants Telegram autorisés (séparés par des virgules).
# La commande /login par mot de passe partagé est désactivée.
# N'ajoutez que des identifiants contrôlés par le propriétaire du serveur.
TELEGRAM_ADMIN_IDS=

# Persistent local database password. Generate with: openssl rand -hex 32
# Never change after initialization without rotating the database role too.
POSTGRES_PASSWORD=replace-with-a-persistent-random-64-character-hex-password
POSTGRES_APP_PASSWORD=replace-with-a-separate-persistent-random-64-character-hex-password

# Enable after the initial administrator has enrolled TOTP.
REQUIRE_ADMIN_MFA=false

# Separate backup encryption key recommended (32+ random characters).
# If empty, MASTER_SECRET is used. Store the key separately from the backups.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional HTTPS receiver; payloads contain alert codes only, signed by HMAC.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=

# Seller information for printable invoices; complete according to your legal status.
INVOICE_SELLER_NAME=ABESS VPN
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_TAX_ID=

# Legacy migration only: plain VLESS TCP is not encrypted. Keep disabled.
ALLOW_INSECURE_TCP=false

# Dedicated SSH tunnel service; administrative SSH on port 22 is unchanged.
SSH_TCP_PORT=2222

# Alternate SSH-WS public port (X-net often uses 8880; default screenshot-compatible 85).
SSH_WS_PUBLIC_PORT=85

# Optional direct VPS IP/hostname for SSH and plain SSH-WS; TLS uses VPN_DOMAIN.
SSH_WS_HOST=
