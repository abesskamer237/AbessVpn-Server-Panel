# Copy this file to .env on the VPS. Never commit real values.
VPN_DOMAIN=vpn.example.com
ACME_EMAIL=admin@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=ABESS VPN Administrator
ADMIN_INITIAL_PASSWORD=replace-with-at-least-16-random-characters
MASTER_SECRET=replace-with-at-least-32-random-characters

# Telegram Management Bot (Gestion commerciale à distance via Telegram)
# Obtenez un token auprès de @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
# Liste obligatoire des identifiants Telegram autorisés (séparés par des virgules).
# La commande /login par mot de passe partagé est désactivée.
# N'ajoutez que des identifiants contrôlés par le propriétaire du serveur.
TELEGRAM_ADMIN_IDS=
